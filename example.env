POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydatabase
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_ENDPOINT=storage:9000
MINIO_BUCKET=kaifind-photos
MINIO_SECURE=false
# Backend development / authentication
APP_ENV=local
MOCK_AUTH_ENABLED=true
AUTH_ENCRYPTION_KEY=
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Photo API limits and service origin
PHOTO_PUBLIC_BASE_URL=http://localhost:8000
PHOTO_MAX_BYTES=10485760
PHOTO_MAX_PIXELS=24000000
PHOTO_UNATTACHED_SECONDS=86400
PHOTO_LINK_SECONDS=60

# Database backups
BACKUP_ENABLED=true
BACKUP_TIME=04:00
BACKUP_TIMEZONE=Asia/Seoul
BACKUP_MINIO_BUCKET=kaifind-db-backups
BACKUP_MINIO_PREFIX=postgres/
BACKUP_RETENTION_DAYS=7
BACKUP_POLL_SECONDS=30
BACKUP_TIMEOUT_SECONDS=1800
BACKUP_MAX_ATTEMPTS=3
BACKUP_RETRY_SECONDS=60,300
BACKUP_CATCH_UP_ENABLED=true

# Notification email (mock provider)
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=mock
NOTIFICATION_EMAIL_DAILY_LIMIT=20
NOTIFICATION_EMAIL_DIGEST_TIME=20:00
NOTIFICATION_EMAIL_APP_BASE_URL=https://localhost:3000
NOTIFICATION_EMAIL_POLL_SECONDS=5
NOTIFICATION_EMAIL_LEASE_SECONDS=120
NOTIFICATION_EMAIL_TIMEOUT_SECONDS=30
NOTIFICATION_EMAIL_RETRY_SECONDS=60,300,1800
NOTIFICATION_EMAIL_RETRY_JITTER_RATIO=0.2
NOTIFICATION_EMAIL_MAX_ATTEMPTS=10

# Daily expiry before database backup
EXPIRY_BATCH_SIZE=100
EXPIRY_MAX_ATTEMPTS=3
EXPIRY_RETRY_SECONDS=60,300
EXPIRY_LOCK_TIMEOUT_SECONDS=10
